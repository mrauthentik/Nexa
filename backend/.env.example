# NEXA Backend / Supabase Edge Functions Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to git — it is in .gitignore

# Supabase connection
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
SERVICE_ROLE_KEY=your-service-role-key-here  # NEVER expose this to the frontend

# AI Services
GROQ_API_KEY=gsk_your-groq-key-here
ELEVENLABS_API_KEY=sk_your-elevenlabs-key-here

# Payment processors (backend webhook verification)
PAYSTACK_SECRET_KEY=sk_live_your-paystack-secret-key
PAYSTACK_WEBHOOK_SECRET=whsec_your-paystack-webhook-secret

# CORS: Set to DEVELOPMENT for local dev, or comma-separated origins for prod
# Example: ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
ALLOWED_ORIGINS=DEVELOPMENT

# Keep-alive secret (optional but recommended)
# The cron job at cron-job.org must send this in x-keep-alive-secret header
KEEP_ALIVE_SECRET=generate-a-random-secret-here
