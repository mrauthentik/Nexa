# NEXA Frontend Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to git — it is in .gitignore

# Supabase (public — safe to expose in frontend bundles)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Paystack (public key is safe for frontend use)
VITE_PAYSTACK_PUBLIC_KEY=pk_live_your-paystack-public-key

# NOTE: Never put GROQ_API_KEY, ELEVENLABS_API_KEY, or SERVICE_ROLE_KEY here.
# Those belong only in backend/.env and Supabase Edge Function secrets.
